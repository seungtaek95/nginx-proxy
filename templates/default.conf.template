upstream be {
    server ${BE_HOST};
    keepalive 32;
}
upstream fe {
    server ${FE_HOST};
    keepalive 32;
}

map $http_user_agent $is_bot {
    default 0;
    ~*googlebot|naverbot|yeti|kakaotalk|slackbot|facebookexternalhit|twitterbot|discordbot|applebot 1;
}

server {
    listen 80;
    server_name 127.0.0.1;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Host $host;

    location /api {
        proxy_pass http://be;
    }

    location / {
        if ($is_bot) {
            proxy_pass http://be/og$request_uri;
            break;
        }

        proxy_pass http://fe;
    }
}
